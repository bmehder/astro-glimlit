---
import '../styles/global.css'

interface Props {
  title: string
}

const { title } = Astro.props
const path = Astro.url.pathname
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Glimlit</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="min-h-screen bg-slate-950 font-sans text-slate-100">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:rounded focus:bg-teal-200 focus:p-3 focus:text-slate-950"
    >
      Skip to content
    </a>
    <div class="mx-auto max-w-5xl px-6">
      <header class="flex flex-wrap items-center justify-between gap-6 border-b border-slate-800 py-6">
        <a href="/" class="text-xl font-semibold text-teal-200">
          Glimlit
        </a>
        <nav
          aria-label="Main navigation"
          class="flex flex-wrap gap-x-5 gap-y-3 text-sm text-slate-300"
        >
          <a
            href="/"
            aria-current={path === '/' ? 'page' : undefined}
            class="hover:text-teal-200 aria-[current]:font-semibold aria-[current]:text-teal-200 aria-[current]:underline aria-[current]:underline-offset-8"
          >
            Home
          </a>
          <a
            href="/demos/"
            aria-current={path.startsWith('/demos') ? 'page' : undefined}
            class="hover:text-teal-200 aria-[current]:font-semibold aria-[current]:text-teal-200 aria-[current]:underline aria-[current]:underline-offset-8"
          >
            Demos
          </a>
          <a
            href="/integration/"
            aria-current={path.startsWith('/integration') ? 'page' : undefined}
            class="hover:text-teal-200 aria-[current]:font-semibold aria-[current]:text-teal-200 aria-[current]:underline aria-[current]:underline-offset-8"
          >
            Integration
          </a>
        </nav>
      </header>
      <main id="main" tabindex="-1" class="py-12 sm:py-20">
        <slot />
      </main>
      <footer class="border-t border-slate-800 py-6 text-sm text-slate-400">
        <a
          href="https://github.com/bmehder/glimlit"
          class="hover:text-teal-200"
        >
          Glimlit · Gleam + lit-html
        </a>
      </footer>
    </div>
  </body>
</html>
